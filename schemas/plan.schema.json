{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/valish/mac-uniden-bcd325p2/blob/main/schemas/plan.schema.json",
  "title": "Uniden BCD325P2 portable channel plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "bcd325p2-plan-v1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "example": {
      "type": "boolean",
      "description": "Examples cannot be programmed until adapted and this flag is removed or false."
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,3}$",
      "description": "A short prefix that distinguishes this plan from other scanner systems, e.g. MU."
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "minItems": 0,
      "maxItems": 20
    },
    "researchDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,40}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "pattern": "^https?://",
            "maxLength": 2000
          },
          "checked": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "checked"
        ]
      },
      "minItems": 0,
      "maxItems": 200
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "enum": [
              "CNV",
              "P25S"
            ]
          },
          "quickKey": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "enabled": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "quickKey": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9
                },
                "channels": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "sourceIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "uniqueItems": true,
                        "maxItems": 30
                      },
                      "notes": {
                        "type": "string",
                        "maxLength": 2000
                      },
                      "frequencyMHz": {
                        "type": "string",
                        "pattern": "^[0-9]{2,3}\\.[0-9]{1,5}$",
                        "description": "MHz as a decimal string, e.g. 162.5500; never a repeater input unless deliberately listening to it."
                      },
                      "mode": {
                        "enum": [
                          "AM",
                          "FM",
                          "NFM",
                          "FMB",
                          "P25"
                        ]
                      },
                      "tgid": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      },
                      "encryption": {
                        "enum": [
                          "clear",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "name"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 1000
                }
              },
              "required": [
                "name",
                "quickKey",
                "channels"
              ]
            },
            "minItems": 1,
            "maxItems": 20
          },
          "sites": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "uniqueItems": true,
                  "maxItems": 30
                },
                "notes": {
                  "type": "string",
                  "maxLength": 2000
                },
                "frequencies": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9]{2,3}\\.[0-9]{1,5}$",
                    "description": "MHz as a decimal string, e.g. 162.5500; never a repeater input unless deliberately listening to it."
                  },
                  "minItems": 1,
                  "maxItems": 100
                }
              },
              "required": [
                "name",
                "frequencies"
              ]
            },
            "minItems": 1,
            "maxItems": 256
          }
        },
        "required": [
          "name",
          "type",
          "quickKey",
          "enabled",
          "groups"
        ]
      },
      "minItems": 1,
      "maxItems": 500
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "uniqueItems": true,
            "maxItems": 30
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "name",
          "reason"
        ]
      },
      "minItems": 0,
      "maxItems": 500
    }
  },
  "required": [
    "format",
    "title",
    "namespace",
    "areas",
    "researchDate",
    "sources",
    "systems"
  ]
}
